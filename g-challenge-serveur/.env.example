# Copiez ce fichier en .env et remplissez les valeurs. Ne publiez JAMAIS le fichier .env.

PORT=3000
URL_PUBLIQUE=http://localhost:3000

# Base PostgreSQL. Sur Supabase : Project Settings > Database > Connection string (mode "Session").
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/gchallenge
# true pour Supabase et la plupart des bases en ligne.
DATABASE_SSL=false

# Clé secrète des sessions : 32 caractères ou plus, au hasard.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-cle-aleatoire-de-48-octets
JWT_DUREE=30d

# Part retenue par la plateforme sur la cagnotte (20 $ -> 5 $ à 25 %).
COMMISSION_POURCENT=25

# Délais des duels
DELAI_REJOINDRE_MINUTES=60
DELAI_COURIR_MINUTES=30

# "simulation" : tous les paiements réussissent sans argent réel. À RETIRER en production.
FOURNISSEUR_FORCE=simulation

# Vodacom M-Pesa RDC (Open API). Valeurs fournies par Vodacom à l'ouverture du compte marchand.
# Sandbox : https://openapi.m-pesa.com/sandbox/ipg/v2/vodacomDRC
# Production : https://openapi.m-pesa.com/openapi/ipg/v2/vodacomDRC
MPESA_RDC_BASE_URL=https://openapi.m-pesa.com/sandbox/ipg/v2/vodacomDRC
MPESA_RDC_API_KEY=
MPESA_RDC_CLE_PUBLIQUE=
MPESA_RDC_CODE_SERVICE=
MPESA_RDC_ORIGINE=*
