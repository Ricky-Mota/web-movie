# En-têtes de sécurité, lus par Cloudflare Pages et par Netlify.
# Si le serveur de jeu change d'adresse (autre que *.onrender.com), ajoutez-la dans script-src et connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.onrender.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.onrender.com wss://*.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
